# Copie para .env apenas no ambiente privado; nunca faça commit de .env.
# Gere um valor persistente e aleatório com: python -c "import secrets; print(secrets.token_urlsafe(48))"
BLOOM_JWT_SECRET=COLOQUE_AQUI_UM_SEGREDO_ALEATORIO_LONGO
# Produção: URL PostgreSQL do provedor. Exemplo de formato, substitua os campos.
BLOOM_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/bloom
BLOOM_DATA_DIR=./bloom_data
# Opcional: use o Supabase gratuito para persistir os arquivos fora do container.
# Crie um bucket privado chamado bloom-assets e não coloque a chave real neste arquivo.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_A_CHAVE_SECRETA_NO_COFRE_DO_HOST
SUPABASE_STORAGE_BUCKET=bloom-assets
BLOOM_CORS_ORIGINS=https://seu-dominio.example
# IDs numéricos de contas moderadoras, separados por vírgula. Descubra seu ID em GET /api/me.
# Sem moderadores configurados, pacotes sinalizados ficam pendentes até administração manual do banco/API.
BLOOM_MODERATOR_USER_IDS=
